{
  "name": "blog-likes-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "npm run types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply blog-likes --local",
    "db:migrate:remote": "wrangler d1 migrations apply blog-likes --remote"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.124.0"
  }
}
